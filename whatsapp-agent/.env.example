# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────
# Token de acceso permanente (System User) o temporal de la app de Meta
WHATSAPP_TOKEN=EAAG...
# ID del número de teléfono (Phone Number ID, NO el número en sí)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token que tú inventas y pones igual en la configuración del webhook en Meta
WHATSAPP_VERIFY_TOKEN=mi-token-secreto-123
# (Opcional) App Secret de Meta para validar la firma de los webhooks
WHATSAPP_APP_SECRET=

# ── Claude (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo para la conversación de ventas (el de mayor volumen — económico)
CLAUDE_MODEL_CHAT=claude-haiku-4-5
# Modelo para validar comprobantes de pago (aquí prima la precisión, no el costo)
CLAUDE_MODEL_RECEIPTS=claude-opus-4-8

# ── Operación ──────────────────────────────────────────────────────────
# Tu número personal de WhatsApp (con código de país, sin +) para recibir
# alertas de comprobantes que requieren revisión manual
ADMIN_WHATSAPP=573001234567
# Puerto del servidor
PORT=3000
# Carpeta donde se guarda TODO lo que se genera en vivo (contactos, ajustes,
# productos y conocimiento editados desde el panel). En Railway usa /data y
# monta ahí un volumen persistente. Por defecto (local): ./data
DATA_DIR=
# Si es "true", NINGÚN comprobante se aprueba automáticamente:
# todos pasan a revisión manual y tú confirmas la entrega
REQUIRE_MANUAL_APPROVAL=false
# Contraseña del panel de control web (http://tu-servidor/admin).
# Si la dejas vacía, el panel queda desactivado.
DASHBOARD_PASSWORD=cambia-esta-clave

# ── Google Sheets (registro de leads y ventas) ─────────────────────────
# URL de tu Apps Script Web App (termina en /exec). Instrucciones en
# google-apps-script.gs. Si la dejas vacía, la integración queda desactivada.
SHEETS_WEBHOOK_URL=
# La misma clave que pusiste en la variable SECRET del Apps Script
SHEETS_SECRET=
